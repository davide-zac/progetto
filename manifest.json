{
    "manifest_version": 3,
    "name": "ReadIT",
    "version": "1.0",
    "description": "Rewriting web content to make it dyslexia friendly.",
    "permissions": ["scripting", "activeTab"],
    "host_permissions": ["<all_urls>"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon16.png",
        "19": "icon19.png",
        "32": "icon32.png",
        "38": "icon38.png",
        "48": "icon48.png",
        "128": "icon128.png"
      }
    },
    "web_accessible_resources": [
    {
      "resources": [
        "fonts/OpenDyslexic-Regular.otf"
      ],
      "matches": ["<all_urls>"]
    }
  ],
    "background": {
      "service_worker": "background.js"
    }
  }
  
    